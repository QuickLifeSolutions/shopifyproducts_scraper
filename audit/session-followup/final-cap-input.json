{
  "maxRequestRetries": 3,
  "maxTotalRequests": 60,
  "startUrls": [
    {
      "url": "https://nl.aybl.com/"
    }
  ],
  "maxConcurrency": 1,
  "maxSitemapPages": 20,
  "checkForBanner": true,
  "fetchHtml": false,
  "extendOutputFunction": "async ({item, product}) => ({...item, additional:{...item.additional, source_variant_count:product.variants.length}})",
  "extendScraperFunction": "async () => {}",
  "maxItems": 1,
  "proxyConfig": {
    "useApifyProxy": true
  },
  "maxRequestsPerCrawl": 1
}
